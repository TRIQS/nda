version = "@PROJECT_VERSION@"
@PROJECT_NAME@_hash = "@PROJECT_GIT_HASH@"

def show_version():
  print("\nYou are using @PROJECT_NAME@ version %s\n"%version)

def show_git_hash():
  print("\nYou are using @PROJECT_NAME@ git hash %s\n"%("@PROJECT_GIT_HASH@"))
